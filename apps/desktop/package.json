{
  "name": "@novarec/desktop",
  "version": "0.0.25",
  "private": true,
  "description": "NovaRec — record, meet, and stream from one shared capture engine.",
  "author": "NovaRec",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder --win --publish never",
    "build:dir": "electron-vite build && electron-builder --dir",
    "start": "electron-vite preview",
    "make-icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@novarec/capture": "workspace:*",
    "@novarec/encoder": "workspace:*",
    "@novarec/shared": "workspace:*",
    "@novarec/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "livekit-client": "^2.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
