{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    /* The shared floor. DOM is here for the web-standard globals that run in
       BOTH Chromium and Node (URL in @novarec/shared) — every package that
       imports @novarec/shared type-checks its source, so this cannot live in one
       package's config. Node-only configs narrow `lib` back to ES2023. */
    "lib": ["ES2023", "DOM"],
    "types": [],

    /* Strictness — spec requires strict mode and no `any`. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    /* Module hygiene */
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    /* Type-check only by default; emitting packages override this. */
    "noEmit": true,
    "declaration": true,
    "sourceMap": true
  }
}
